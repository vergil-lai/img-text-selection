{
  "name": "img-text-selection",
  "version": "0.1.0",
  "description": "Local browser image text selection powered by PP-OCRv6 Tiny.",
  "keywords": [
    "browser",
    "ocr",
    "onnx",
    "pp-ocrv6",
    "text-selection",
    "wasm",
    "webgpu"
  ],
  "homepage": "https://github.com/vergil-lai/img-text-selection#readme",
  "bugs": {
    "url": "https://github.com/vergil-lai/img-text-selection/issues"
  },
  "license": "MIT",
  "author": "Vergil Lai<vergil@vip.163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vergil-lai/img-text-selection.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/directive.d.ts",
      "import": "./dist/vue/directive.js"
    },
    "./style.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --pretty false",
    "commitlint": "commitlint --last --verbose",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "husky",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.12.0",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "onnxruntime-web": "^1.27.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
